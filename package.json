{
  "name": "hono-idempotent-request",
  "version": "0.0.0",
  "private": true,
  "description": "Idempotent request middleware for Hono, compliant with IETF draft-ietf-httpapi-idempotency-key-header-07",
  "keywords": [
    "api",
    "hono",
    "http",
    "idempotency",
    "idempotency-key",
    "idempotent",
    "ietf",
    "middleware",
    "rest"
  ],
  "homepage": "https://github.com/sushichan044/hono-idempotent-request#readme",
  "bugs": {
    "url": "https://github.com/sushichan044/hono-idempotent-request/issues"
  },
  "license": "MIT",
  "author": {
    "name": "sushichan044",
    "url": "https://github.com/sushichan044"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sushichan044/hono-idempotent-request.git"
  },
  "funding": "https://github.com/sponsors/sushichan044",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check": "vp check",
    "tidy": "vp check --fix",
    "test": "vp test --run",
    "build": "vp pack",
    "pkg-pr-new": "pkg-pr-new publish --compact --comment=update --pnpm"
  },
  "dependencies": {
    "structured-headers": "2.0.2"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:dev",
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@types/node": "catalog:dev",
    "@typescript/native-preview": "catalog:dev",
    "@virtual-live-lab/tsconfig": "catalog:dev",
    "pkg-pr-new": "catalog:dev",
    "publint": "catalog:dev",
    "release-it": "catalog:dev",
    "release-it-pnpm": "catalog:dev",
    "typescript": "catalog:dev",
    "unplugin-unused": "catalog:dev",
    "uuid": "14.0.0",
    "vite-plus": "catalog:dev"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "packageManager": "pnpm@11.4.0"
}
